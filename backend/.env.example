NIDS_ENV=development
NIDS_API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=adaptive_nids
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=adaptive-ai-nids
JWT_AUDIENCE=adaptive-ai-nids-api
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
MAX_ROWS_PER_DATASET=100000
ARTIFACT_STORAGE_DIR=./var/artifacts
MODEL_ARTIFACT_DIR=./var/models
ACTIVE_MODEL_VERSION=unavailable
LOG_LEVEL=INFO
ALLOW_DEGRADED_MODEL=true
